# TaskForge configuration.
#
# Copy to .env and edit:   make setup
#
# .env is git-ignored and must never contain production credentials.
# Keep values unquoted and free of spaces: this file is both read by Docker
# Compose and `include`d by the Makefile, and neither handles quoting the way
# a shell does.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# development | staging | production
APP_ENV=development

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# debug | info | warn | error   (debug also attaches source file:line)
LOG_LEVEL=info
# text | json                   (use json in staging/production)
LOG_FORMAT=text

# ---------------------------------------------------------------------------
# HTTP API
# ---------------------------------------------------------------------------
HTTP_ADDR=:8080
# Time allowed to read the request headers and body.
HTTP_READ_TIMEOUT=5s
# Time allowed to write the response.
HTTP_WRITE_TIMEOUT=10s
# How long an idle keep-alive connection is kept open.
HTTP_IDLE_TIMEOUT=60s
# Grace period for in-flight requests during shutdown.
HTTP_SHUTDOWN_TIMEOUT=15s
# Hard cap on request body size, in bytes. 65536 = 64 KiB.
HTTP_MAX_BODY_BYTES=65536

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# localhost when running the Go binaries on your machine.
# Set to `postgres` when the binaries themselves run inside Docker Compose.
DB_HOST=localhost
# HOST-side port only. Inside the Compose network Postgres is always
# postgres:5432 regardless of this value.
#
# 5433 rather than 5432 on purpose: a locally installed PostgreSQL service
# already owns 5432 on many developer machines, and the failure mode is
# confusing - the connection succeeds and then fails authentication against
# the wrong server. Pick any free port here.
DB_PORT=5433
DB_USER=taskforge
DB_PASSWORD=taskforge
DB_NAME=taskforge
# disable | require | verify-ca | verify-full
DB_SSLMODE=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
DB_CONNECT_TIMEOUT=5s

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
# Leave empty to derive `hostname-pid` automatically. Set explicitly only when
# you need a stable identity across restarts.
WORKER_ID=
# Jobs executed simultaneously by ONE worker process (goroutines in its pool).
# Total system concurrency = WORKER_CONCURRENCY x number of worker processes.
# Must be at most DB_MAX_CONNS - 1: a worker needs a connection per running job
# plus one for the claim query.
WORKER_CONCURRENCY=5
# How often a worker with spare capacity asks the database for work when the
# queue was empty. Does NOT delay work when jobs are available.
WORKER_POLL_INTERVAL=1s
# Grace period for in-flight jobs after SIGTERM/SIGINT.
WORKER_SHUTDOWN_TIMEOUT=30s

# Visibility timeout: how long a worker owns a claimed job before another
# worker may reclaim it.
#
# The worker RENEWS this every LEASE_DURATION/3 while a job runs, so it does
# NOT limit how long a job may take. Keep it short: it is the main term in how
# quickly a crashed worker's jobs are recovered. Minimum 5s, so a brief
# database hiccup cannot expire a healthy job's lease.
WORKER_LEASE_DURATION=60s
# Maximum runtime for a single handler. May exceed WORKER_LEASE_DURATION,
# because the lease is renewed while the job runs.
WORKER_JOB_TIMEOUT=30s

# How often each worker looks for jobs whose lease expired because their worker
# died. Worst-case recovery time is roughly LEASE_DURATION + REAPER_INTERVAL.
# Every worker runs a reaper; the query uses SKIP LOCKED so they never conflict.
WORKER_REAPER_INTERVAL=30s
# Jobs reclaimed per pass. Bounded so the transaction stays short after a mass
# outage; the reaper simply runs several passes.
WORKER_REAPER_BATCH=100

# How often a worker refreshes its row in the `workers` inventory table.
# The API reports a worker as not alive after three missed beats.
WORKER_HEARTBEAT_INTERVAL=10s
# How long a silent worker's row is kept before it is pruned, so the table does
# not accumulate one row per container that has ever existed.
WORKER_RETENTION=1h

# ---------------------------------------------------------------------------
# Priority aging (starvation control)
# ---------------------------------------------------------------------------
# With strict `ORDER BY priority DESC`, a steady stream of high-priority work
# means a low-priority job is NEVER the best candidate - it is not slow, it is
# never selected. Aging raises a job's effective priority the longer it waits:
#
#   effective = priority + min(minutes_waited * BOOST_PER_MINUTE, MAX_BOOST)
#
# OFF by default: the strict ordering matches jobs_claim_idx exactly so
# PostgreSQL never sorts, while the aged ordering is a computed expression that
# no index can serve. That is cheap while the pending set is small (which the
# partial index ensures) but it is a real cost. Turn it on when you actually run
# mixed priorities.
WORKER_AGING_ENABLED=false
WORKER_AGING_BOOST_PER_MINUTE=1
WORKER_AGING_MAX_BOOST=50

# Retry backoff: delay = BASE * FACTOR^(attempt-1), capped at MAX, then
# jittered to avoid a synchronised thundering herd.
# Defaults give roughly 1s, 2s, 4s, 8s, 16s ... capped at 5m.
WORKER_BACKOFF_BASE=1s
WORKER_BACKOFF_MAX=5m
WORKER_BACKOFF_FACTOR=2

# ---------------------------------------------------------------------------
# Job handlers
# ---------------------------------------------------------------------------
# Timeout for one outbound webhook attempt. Must be shorter than
# WORKER_JOB_TIMEOUT so the handler reports a useful error itself.
WEBHOOK_TIMEOUT=10s
# Allow webhooks to reach loopback and private addresses.
# true is needed to test against a local server. Leave it FALSE in production:
# a job payload containing http://169.254.169.254/... would otherwise turn the
# queue into a cloud-credential exfiltration tool (SSRF).
WEBHOOK_ALLOW_PRIVATE_TARGETS=true
# Simulated provider latency for the stub email sender.
EMAIL_SIMULATED_LATENCY=50ms
